def create_custom_httpx_client(**kwargs):
    """
    Factory to create a custom httpx client with SSL verification disabled,
    while forwarding other arguments.
    """
    kwargs["verify"] = False
    # Set more aggressive timeout configuration for server-side connection issues
    kwargs["timeout"] = httpx.Timeout(
        connect=60.0,   # Increased connection timeout
        read=300.0,     # 5 minutes read timeout for slow server responses
        write=60.0,     # Write timeout
        pool=60.0       # Pool timeout
    )
    return httpx.AsyncClient(**kwargs)

# Create a transport with the custom httpx client factory
transport = StreamableHttpTransport(
#     url=mcp_url_dev,
#       url=mcp_url_uat,
    # url="https://6e-mcp-server-core.goindigo.in/mcp",
    url="http://localhost:8080/mcp",
    httpx_client_factory=create_custom_httpx_client,
)

# Initialize the MCP client with the custom transport
client = Client(transport=transport)

def print_payload_subset(payload):
    print("---- Full Payload ----")
    print(json.dumps(payload, indent=4))
    print("---- First block of the payload ----")
    if isinstance(payload, list):
        if not payload:
            print("Payload is an empty list.")
            return
        subset_payload = payload[:1]
        print(json.dumps(subset_payload, indent=4))
    elif isinstance(payload, dict):
        if not payload:
            print("Payload is an empty dictionary.")
            return
        first_item_key = next(iter(payload))
        subset_payload = {first_item_key: payload[first_item_key]}
        print(json.dumps(subset_payload, indent=4))
    else:
        print(json.dumps(payload, indent=4))


