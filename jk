        ("uniform", "uniform_detail"),
        ("hairstyle", "hair_detail"),
        ("makeup", "makeup_detail"),
        ("nails", "nails_detail"),
        ("accessories", "acc_detail"),
    ]:
        _, v = _extract(_rx[rx_key], text)
        details[key] = v

    cats: Dict[str, Optional[float]] = {}
    for c, rx_c in [
        ("uniform", "uniform_score"),
        ("nails", "nails_score"),
