def _post_gemini(parts):
    """Send request to Gemini API and return text response."""
    headers = {"Content-Type": "application/json"}
    payload = {"contents": [{"parts": parts}]}
    r = requests.post(GEMINI_ENDPOINT, headers=headers, json=payload, timeout=60)
    r.raise_for_status()
    data = r.json()
    try:
        return data["candidates"][0]["content"]["parts"][0]["text"]
    except Exception:
        return ""

def _normalize_output(report_text: str) -> str:
    """
    Clean and normalize the report:
    1. Remove any (Evidence: Frame X.Xs) tags
    2. Ensure all scores are in X.X format (decimal)
    3. Keep (NOT VISIBLE) tags and explanations
    4. Verify no dashes or question marks in scoring
    """
    
    # Remove (Evidence: ...) tags completely
    report_text = re.sub(r'\s*\(Evidence:[^)]*\)', '', report_text, flags=re.IGNORECASE)
    
    # Fix Overall Score line: ensure decimal format
    report_text = re.sub(
        r'(Overall\s*Score)\s*:\s*([0-9]+(?:\.[0-9]+)?)\s*/\s*10(?:[.\s]|$)',
        lambda m: f"{m.group(1)}: {float(m.group(2)):.1f}/10.0\n",
        report_text,
        flags=re.IGNORECASE
    )
    
    # Fix per-category score lines with proper handling
    category_maxes = {
        "UNIFORM": 3.0,
        "Uniform": 3.0,
        "NAILS": 1.0,
        "Nails": 1.0,
        "HAIRSTYLE": 2.0,
        "Hairstyle": 2.0,
        "MAKEUP": 2.0,
        "Makeup": 2.0,
        "ACCESSORIES": 2.0,
        "Accessories": 2.0,
    }
    
    for cat, maxval in category_maxes.items():
        # Pattern: "Hairstyle: X/2" or "Hairstyle: 1.5/2.0"
        pattern = rf'(^-?\s*{re.escape(cat)}\s*:\s*)([0-9]+(?:\.[0-9]+)?)\s*/\s*([0-9]+(?:\.[0-9]+)?)'
        
        def replace_score(m):
            label = m.group(1)
            num_str = m.group(2)
            denom_str = m.group(3)
            
            num = float(num_str)
            denom = float(denom_str)
            return f"{label}{num:.1f}/{denom:.1f}"
        
        report_text = re.sub(pattern, replace_score, report_text, flags=re.MULTILINE | re.IGNORECASE)
    
    # Ensure no dashes or question marks in scores
    report_text = re.sub(r':\s*-\s*/\s*([0-9]+(?:\.[0-9]+)?)', r': 0.0/\1', report_text)
    report_text = re.sub(r':\s*\?\s*/\s*([0-9]+(?:\.[0-9]+)?)', r': 0.0/\1', report_text)
    
    return report_text

def check_grooming(image_b64: str) -> str:
    """
    Sends a single base64 image and returns a detailed, normalized grooming report.
    """
    prompt = f"{FACE_GROOMING_PROMPT}\n\n{OUTPUT_FORMAT}"
    parts = [
        {"text": prompt},
        {"inline_data": {"mime_type": "image/jpeg", "data": image_b64}},
    ]
    raw = _post_gemini(parts)
    return _normalize_output(raw)

def check_grooming_from_video(video_path: str, name: str, iga_code: str) -> str:
    """
    Encodes a video and returns a detailed, normalized grooming report.
    Samples frames uniformly and provides comprehensive assessment.
    """
    with open(video_path, "rb") as f:
        video_b64 = base64.b64encode(f.read()).decode("utf-8")

    prompt = (
        f"{FACE_GROOMING_PROMPT}\n\n"
        "CRITICAL INSTRUCTIONS FOR VIDEO ANALYSIS:\n"
        "- Do NOT include any (Evidence: Frame X.Xs) tags in output\n"
        "- Sample frames uniformly at 1 fps with 0.5s offset, maximum 12 frames\n"
        "- Mark unseen items as (NOT VISIBLE) and do not deduct points\n"
        "- For each category, show detailed sub-category breakdown\n"
        "- Provide complete explanations of all assessments\n"
        "- Be detailed and explanatory so the crew member understands their assessment\n"
        "- Apply majority rule across frames; on tie, use stricter outcome\n\n"
        f"{OUTPUT_FORMAT}"
    )
    parts = [
        {"text": prompt},
        {"inline_data": {"mime_type": "video/webm", "data": video_b64}},
    ]
    raw = _post_gemini(parts)
    normalized = _normalize_output(raw)
    
    # Add crew info header
    header = f"GROOMING ASSESSMENT RESULT (VIDEO)\nCrew Member: {name} | IGA Code: {iga_code}\n\n"
    return header + normalized

def check_grooming_from_frames(frames_b64: list[str], name: str, iga_code: str) -> str:
    """
    Sends a list of base64 frames and concatenates detailed reports.
    Provides frame-by-frame assessment with consolidated summary.
    """
    results = []
    frame_scores = []
    
    for idx, image_b64 in enumerate(frames_b64, start=1):
        reply = check_grooming(image_b64)
        results.append(f"--- FRAME {idx} ASSESSMENT ---\n{reply}")
        
        # Extract score for summary
        score_match = re.search(r'Overall Score:\s*([0-9.]+)/10\.0', reply)
        if score_match:
            frame_scores.append(float(score_match.group(1)))
    
    # Calculate average score
    avg_score = sum(frame_scores) / len(frame_scores) if frame_scores else 0.0
    
    summary = f"""
CONSOLIDATED ASSESSMENT FOR {name} (IGA: {iga_code})

Average Score Across All Frames: {avg_score:.1f}/10.0
Final Assessment: {'COMPLIANT' if avg_score >= 7.0 else 'NON-COMPLIANT'}

Individual Frame Results:
"""
    
    return summary + "\n".join(results)

