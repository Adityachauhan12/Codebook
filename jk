"""

def _post_gemini(parts):
    """Send request to Gemini API and return text response."""
    headers = {"Content-Type": "application/json"}
    payload = {"contents": [{"parts": parts}]}
    r = requests.post(GEMINI_ENDPOINT, headers=headers, json=payload, timeout=60)
    r.raise_for_status()
    data = r.json()
    try:
        return data["candidates"][0]["content"]["parts"][0]["text"]
    except Exception:
        return ""

def _normalize_output(report_text: str) -> str:
    """
    Clean and normalize the report:
    1. Remove any (Evidence: Frame X.Xs) tags
    2. Ensure all scores are in X.X format (decimal)
    3. Replace dashes (-) in scores with proper values
    4. Keep (NOT VISIBLE) tags and explanations
    """
    
    # Remove (Evidence: ...) tags completely
    report_text = re.sub(r'\s*\(Evidence:[^)]*\)', '', report_text, flags=re.IGNORECASE)
    
    # Fix Overall Score line: ensure decimal format
    report_text = re.sub(
        r'(Overall\s*Score)\s*:\s*([0-9]+(?:\.[0-9]+)?)\s*/\s*10(?:[.\s]|$)',
        lambda m: f"{m.group(1)}: {float(m.group(2)):.1f}/10.0\n",
        report_text,
        flags=re.IGNORECASE
    )
    
    # Fix per-category score lines with proper handling
    category_maxes = {
        "Uniform": 3.0,
        "Nails": 1.0,
        "Hairstyle": 2.0,
        "Makeup": 2.0,
        "Accessories": 2.0,
    }
    
    for cat, maxval in category_maxes.items():
        # Pattern: "Hairstyle: X/2" or "Hairstyle: -/2" or "Hairstyle: 1.5/2.0"
        pattern = rf'(^-?\s*{cat}\s*:\s*)([0-9]+(?:\.[0-9]+)?|-)\s*/\s*([0-9]+(?:\.[0-9]+)?)'
        
        def replace_score(m):
            label = m.group(1)
            num_str = m.group(2)
            denom_str = m.group(3)
            
            # If numerator is a dash, use full score (for NOT VISIBLE items)
            if num_str == '-':
                num = maxval
            else:
                num = float(num_str)
            
            denom = float(denom_str)
            return f"{label}{num:.1f}/{denom:.1f}"
        
        report_text = re.sub(pattern, replace_score, report_text, flags=re.MULTILINE | re.IGNORECASE)
    
    return report_text

def check_grooming(image_b64: str) -> str:
    """
    Sends a single base64 image and returns a detailed, normalized grooming report.
    """
    prompt = f"{FACE_GROOMING_PROMPT}\n\n{OUTPUT_FORMAT}"
    parts = [
        {"text": prompt},
        {"inline_data": {"mime_type": "image/jpeg", "data": image_b64}},
    ]
    raw = _post_gemini(parts)
    return _normalize_output(raw)

def check_grooming_from_video(video_path: str, name: str, iga_code: str) -> str:
    """
    Encodes a video and returns a detailed, normalized grooming report.
    """
    with open(video_path, "rb") as f:
        video_b64 = base64.b64encode(f.read()).decode("utf-8")

    prompt = (
        f"{FACE_GROOMING_PROMPT}\n\n"
        "CRITICAL: Do NOT include any (Evidence: Frame X.Xs) tags in your output.\n"
        "Analyze this short clip for grooming compliance.\n"
        "Sample frames uniformly; mark unseen items as (NOT VISIBLE) and do not deduct.\n"
        "For each category, show sub-category breakdown and explain what was observed.\n"
        "Be detailed and explanatory so the crew member understands the assessment.\n\n"
        f"{OUTPUT_FORMAT}"
    )
    parts = [
        {"text": prompt},
        {"inline_data": {"mime_type": "video/webm", "data": video_b64}},
    ]
    raw = _post_gemini(parts)
    normalized = _normalize_output(raw)
    
    # Add crew info header
    header = f"Grooming Result (Video)\n{name} • IGA: {iga_code}\n\n"
    return header + normalized

def check_grooming_from_frames(frames_b64: list[str], name: str, iga_code: str) -> str:
    """
    Sends a list of base64 frames and concatenates detailed reports.
    """
    results = []
    for idx, image_b64 in enumerate(frames_b64, start=1):
        reply = check_grooming(image_b64)
        results.append(f"Frame {idx} Result:\n{reply}")
    return f"Grooming check results for {name} ({iga_code}):\n\n" + "\n\n".join(results)
