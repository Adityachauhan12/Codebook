const [baseData, setBaseData] = useState<BaseData[]>([]);


// ⭐ ADD THIS ENTIRE FUNCTION after your existing fetch functions
const fetchBaseData = async () => {
  let queryParams = "";

  if (selectedFilter === "last2weeks") {
    queryParams = "?days=14";
  } else if (selectedFilter === "lastMonth") {
    queryParams = "?days=30";
  } else if (selectedFilter === "custom" && customStart && customEnd) {
    queryParams = `?dateFrom=${customStart.toISOString().split("T")[0]}&dateTo=${customEnd.toISOString().split("T")[0]}`;
  }

  try {
    const response = await fetch(`${API_URL}/by-base${queryParams}`);
    if (!response.ok) {
      console.error("Failed to fetch base data");
      setBaseData([]);
      return;
    }

    const data = await response.json();
    console.log("Base data:", data);
    setBaseData(data.bases || []);
  } catch (error) {
    console.error("Error fetching base data:", error);
    setBaseData([]);
  }
};





// Find your existing useEffect that calls fetchFilteredData
// ADD fetchBaseData(); call to it:

useEffect(() => {
  if (selectedFilter === "") return;

  if (selectedFilter === "custom") {
    if (customStart && customEnd) {
      fetchFilteredData();
      fetchBaseData();  // ⭐ ADD THIS LINE
    }
  } else {
    fetchFilteredData();
    fetchBaseData();  // ⭐ ADD THIS LINE
  }
}, [selectedFilter, customStart, customEnd]);







